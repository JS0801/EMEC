        </#list>
    </#if>
<#else>
            <tr><td style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">${check.trandate}</td><td style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">${check.memo!""}</td><td align="right" style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;"><#if (check.usertotal!"")?has_content>
${check.usertotal}
<#else>
${check.total}
</#if></td></tr>
    <#list 1..7 as blankRow>
