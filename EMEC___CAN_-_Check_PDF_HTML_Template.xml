<?xml version="1.0"?>
<!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
<head>
	<link name="NotoSans" type="font" subtype="truetype" src="${nsfont.NotoSans_Regular}" src-bold="${nsfont.NotoSans_Bold}" src-italic="${nsfont.NotoSans_Italic}" src-bolditalic="${nsfont.NotoSans_BoldItalic}" bytes="2" />
<#if .locale == "zh_CN">
		<link name="NotoSansCJKsc" type="font" subtype="opentype" src="${nsfont.NotoSansCJKsc_Regular}" src-bold="${nsfont.NotoSansCJKsc_Bold}" bytes="2" />
<#elseif .locale == "zh_TW">
		<link name="NotoSansCJKtc" type="font" subtype="opentype" src="${nsfont.NotoSansCJKtc_Regular}" src-bold="${nsfont.NotoSansCJKtc_Bold}" bytes="2" />
<#elseif .locale == "ja_JP">
		<link name="NotoSansCJKjp" type="font" subtype="opentype" src="${nsfont.NotoSansCJKjp_Regular}" src-bold="${nsfont.NotoSansCJKjp_Bold}" bytes="2" />
<#elseif .locale == "ko_KR">
		<link name="NotoSansCJKkr" type="font" subtype="opentype" src="${nsfont.NotoSansCJKkr_Regular}" src-bold="${nsfont.NotoSansCJKkr_Bold}" bytes="2" />
<#elseif .locale == "th_TH">
		<link name="NotoSansThai" type="font" subtype="opentype" src="${nsfont.NotoSansThai_Regular}" src-bold="${nsfont.NotoSansThai_Bold}" bytes="2" />
</#if>
	<style>
		* {
<#if .locale == "zh_CN">
			font-family: NotoSans, NotoSansCJKsc, sans-serif;
<#elseif .locale == "zh_TW">
			font-family: NotoSans, NotoSansCJKtc, sans-serif;
<#elseif .locale == "ja_JP">
			font-family: NotoSans, NotoSansCJKjp, sans-serif;
<#elseif .locale == "ko_KR">
			font-family: NotoSans, NotoSansCJKkr, sans-serif;
<#elseif .locale == "th_TH">
			font-family: NotoSans, NotoSansThai, sans-serif;
<#else>
			font-family: NotoSans, sans-serif;
</#if>
		}
        .check table {
            position: relative;
            overflow: hidden;
            font-size: 8pt;
        }
		td p { align:left }
        .remittance { font-size: 8pt; table-layout: fixed; }
        .remittance th { padding: 3pt; background-color: #eeeeee; border-bottom: 0.5pt solid #777777; }
    </style>
</head>
<#-- Use full-page Letter PNG/JPG backgrounds. Replace the URL inside each
     currency branch. Use literal & in the FreeMarker URL string; ?xml escapes it.
     Remove sample check numbers from the artwork. MICR is not generated here.
     Each currency branch below is complete, with literal positions and two
     separately written remittance tables; no shared layout macros or coordinates.
     check.apply supplies applied bill rows. Checks without applied bills show memo.
-->
<body padding="0pt 0pt 0pt 0pt" size="Letter">
<#list records as check>
    
<#if check_index != 0>
<pbr />
</#if>
    
<#if (check.currency!"")?string?trim?upper_case == "USD">
    <#-- ==================== COMPLETE USD LAYOUT ==================== -->
    <#assign USD_BACKGROUND_URL = "REPLACE_WITH_USD_BACKGROUND_IMAGE_URL">
      
    <div style="position: relative; width: 612pt; height: 790pt; font-size: 9pt;">
<#if USD_BACKGROUND_URL?has_content && !USD_BACKGROUND_URL?starts_with("REPLACE_WITH_")>
        <img src="${USD_BACKGROUND_URL?xml}" style="position: absolute; left: 0pt; top: 0pt; width: 612pt; height: 792pt;" />
</#if>
        <table style="position: absolute; left: 536pt; top: 10pt; width: 68pt; height: 22pt; font-size: 12pt; background-color: #ffffff;"><tr><td align="center" style="padding: 0pt;">${check.checknumber}</td></tr></table>
        <table style="position: absolute; left: 536pt; top: 296pt; width: 68pt; height: 22pt; font-size: 12pt; background-color: #ffffff;"><tr><td align="center" style="padding: 0pt;">${check.checknumber}</td></tr></table>
        <table style="position: absolute; left: 536pt; top: 548pt; width: 68pt; height: 22pt; font-size: 12pt; background-color: #ffffff;"><tr><td align="center" style="padding: 0pt;">${check.checknumber}</td></tr></table>
        <table style="position: absolute; left: 470pt; top: 324pt; width: 120pt; height: 14pt; font-size: 10pt;"><tr><td align="center" style="padding: 0pt;">
<#if check.trandate?is_date_like>
${check.trandate?string("dd MM yyyy")}
<#else>
${check.trandate}
</#if>
</td></tr></table>
        <table style="position: absolute; left: 34pt; top: 362pt; width: 404pt; height: 26pt; font-size: 9pt;"><tr><td align="left" style="padding: 0pt;">${check.totalwords} ***</td></tr></table>
        <table style="position: absolute; left: 491pt; top: 362pt; width: 94pt; height: 20pt; font-size: 11pt;"><tr><td align="right" style="padding: 0pt;">**
<#if (check.usertotal!"")?has_content>
${check.usertotal}
<#else>
${check.total}
</#if>
</td></tr></table>
        <table style="position: absolute; left: 13pt; top: 411pt; width: 296pt; height: 17pt; font-size: 9pt;"><tr><td align="left" style="padding: 0pt;">${check.entity}</td></tr></table>
        <table style="position: absolute; left: 13pt; top: 427pt; width: 296pt; height: 36pt; font-size: 8pt;"><tr><td align="left" style="padding: 0pt;">${check.address}</td></tr></table>
        <table style="position: absolute; left: 13pt; top: 464pt; width: 296pt; height: 12pt; font-size: 7pt;"><tr><td align="left" style="padding: 0pt;">${check.memo}</td></tr></table>
        <#-- Voucher 1: independent remittance markup. -->
        <table style="position: absolute; left: 18pt; top: 38pt; width: 576pt; font-size: 8pt;">
            <tr><td width="365pt"><b>REMITTANCE - USD</b><br />Payee: ${check.entity}</td><td align="right">Date: ${check.trandate}<br />Check: ${check.checknumber}</td></tr>
        </table>
        <table class="remittance" cellpadding="0" cellspacing="0" style="position: absolute; left: 18pt; top: 70pt; width: 576pt; border-collapse: collapse; border: 0.75pt solid #333333; background-color: #ffffff; font-size: 8pt; table-layout: fixed;">
            <tr>
                <td width="100pt" style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt; background-color: #dddddd;"><b>Invoice Date</b></td>
                <td width="340pt" style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt; background-color: #dddddd;"><b>Invoice / Reference</b></td>
                <td width="136pt" align="right" style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt; background-color: #dddddd;"><b>Amount Paid (USD)</b></td>
            </tr>
<#if check.apply?has_content>
    <#list check.apply as bill>
            <tr>
                <td style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">${bill.applydate!""}</td>
                <td style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">${bill.refnum!""}</td>
                <td align="right" style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">${bill.amount!""}</td>
            </tr>
    </#list>
    <#if check.apply?size lt 8>
        <#list 1..(8 - check.apply?size) as blankRow>
            <tr><td style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">&#160;</td><td style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">&#160;</td><td style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">&#160;</td></tr>
        </#list>
    </#if>
<#else>
            <tr><td style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">${check.trandate}</td><td style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">${check.memo!""}</td><td align="right" style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;"><#if (check.usertotal!"")?has_content>
${check.usertotal}
<#else>
${check.total}
</#if></td></tr>
    <#list 1..7 as blankRow>
            <tr><td style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">&#160;</td><td style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">&#160;</td><td style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">&#160;</td></tr>
    </#list>
</#if>
            <tr><td colspan="2" align="right" style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt; background-color: #eeeeee;"><b>Check Total (USD)</b></td><td align="right" style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt; background-color: #eeeeee;"><b><#if (check.usertotal!"")?has_content>
${check.usertotal}
<#else>
${check.total}
</#if></b></td></tr>
        </table>
        <#-- Voucher 2: independent remittance markup. -->
        <table style="position: absolute; left: 18pt; top: 574pt; width: 576pt; font-size: 8pt;">
            <tr><td width="365pt"><b>REMITTANCE - USD</b><br />Payee: ${check.entity}</td><td align="right">Date: ${check.trandate}<br />Check: ${check.checknumber}</td></tr>
        </table>
        <table class="remittance" cellpadding="0" cellspacing="0" style="position: absolute; left: 18pt; top: 606pt; width: 576pt; border-collapse: collapse; border: 0.75pt solid #333333; background-color: #ffffff; font-size: 8pt; table-layout: fixed;">
            <tr>
                <td width="100pt" style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt; background-color: #dddddd;"><b>Invoice Date</b></td>
                <td width="340pt" style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt; background-color: #dddddd;"><b>Invoice / Reference</b></td>
                <td width="136pt" align="right" style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt; background-color: #dddddd;"><b>Amount Paid (USD)</b></td>
            </tr>
<#if check.apply?has_content>
    <#list check.apply as bill>
            <tr>
                <td style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">${bill.applydate!""}</td>
                <td style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">${bill.refnum!""}</td>
                <td align="right" style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">${bill.amount!""}</td>
            </tr>
    </#list>
    <#if check.apply?size lt 8>
        <#list 1..(8 - check.apply?size) as blankRow>
            <tr><td style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">&#160;</td><td style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">&#160;</td><td style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">&#160;</td></tr>
        </#list>
    </#if>
<#else>
            <tr><td style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">${check.trandate}</td><td style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">${check.memo!""}</td><td align="right" style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;"><#if (check.usertotal!"")?has_content>
${check.usertotal}
<#else>
${check.total}
</#if></td></tr>
    <#list 1..7 as blankRow>
            <tr><td style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">&#160;</td><td style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">&#160;</td><td style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">&#160;</td></tr>
    </#list>
</#if>
            <tr><td colspan="2" align="right" style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt; background-color: #eeeeee;"><b>Check Total (USD)</b></td><td align="right" style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt; background-color: #eeeeee;"><b><#if (check.usertotal!"")?has_content>
${check.usertotal}
<#else>
${check.total}
</#if></b></td></tr>
        </table>
    </div>
<#else>
    

    <#-- ==================== COMPLETE CAD LAYOUT ==================== -->
    <#assign CAD_BACKGROUND_URL = "REPLACE_WITH_CAD_BACKGROUND_IMAGE_URL">
    <div style="position: relative; width: 612pt; height: 790pt; font-size: 9pt;">
<#if CAD_BACKGROUND_URL?has_content && !CAD_BACKGROUND_URL?starts_with("REPLACE_WITH_")>
        <img src="${CAD_BACKGROUND_URL?xml}" style="position: absolute; left: 0pt; top: 0pt; width: 612pt; height: 792pt;" />
</#if>
        <table style="position: absolute; left: 536pt; top: 10pt; width: 68pt; height: 22pt; font-size: 12pt; background-color: #ffffff;"><tr><td align="center" style="padding: 0pt;">${check.checknumber}</td></tr></table>
        <table style="position: absolute; left: 536pt; top: 293pt; width: 68pt; height: 22pt; font-size: 12pt; background-color: #ffffff;"><tr><td align="center" style="padding: 0pt;">${check.checknumber}</td></tr></table>
        <table style="position: absolute; left: 536pt; top: 552pt; width: 68pt; height: 22pt; font-size: 12pt; background-color: #ffffff;"><tr><td align="center" style="padding: 0pt;">${check.checknumber}</td></tr></table>
        <table style="position: absolute; left: 470pt; top: 586pt; width: 120pt; height: 14pt; font-size: 10pt;"><tr><td align="center" style="padding: 0pt;">
<#if check.trandate?is_date_like>
${check.trandate?string("dd MM yyyy")}
<#else>
${check.trandate}
</#if>
</td></tr></table>
        <table style="position: absolute; left: 34pt; top: 637pt; width: 404pt; height: 26pt; font-size: 9pt;"><tr><td align="left" style="padding: 0pt;">${check.totalwords} ***</td></tr></table>
        <table style="position: absolute; left: 491pt; top: 637pt; width: 94pt; height: 20pt; font-size: 11pt;"><tr><td align="right" style="padding: 0pt;">**
<#if (check.usertotal!"")?has_content>
${check.usertotal}
<#else>
${check.total}
</#if>
</td></tr></table>
        <table style="position: absolute; left: 13pt; top: 680pt; width: 296pt; height: 17pt; font-size: 9pt;"><tr><td align="left" style="padding: 0pt;">${check.entity}</td></tr></table>
        <table style="position: absolute; left: 13pt; top: 696pt; width: 296pt; height: 36pt; font-size: 8pt;"><tr><td align="left" style="padding: 0pt;">${check.address}</td></tr></table>
        <table style="position: absolute; left: 13pt; top: 730pt; width: 296pt; height: 12pt; font-size: 7pt;"><tr><td align="left" style="padding: 0pt;">${check.memo}</td></tr></table>
        <#-- Voucher 1: independent remittance markup. -->
        <table style="position: absolute; left: 18pt; top: 38pt; width: 576pt; font-size: 8pt;">
            <tr><td width="365pt"><b>REMITTANCE - CAD</b><br />Payee: ${check.entity}</td><td align="right">Date: ${check.trandate}<br />Check: ${check.checknumber}</td></tr>
        </table>
        <table class="remittance" cellpadding="0" cellspacing="0" style="position: absolute; left: 18pt; top: 70pt; width: 576pt; border-collapse: collapse; border: 0.75pt solid #333333; background-color: #ffffff; font-size: 8pt; table-layout: fixed;">
            <tr>
                <td width="100pt" style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt; background-color: #dddddd;"><b>Invoice Date</b></td>
                <td width="340pt" style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt; background-color: #dddddd;"><b>Invoice / Reference</b></td>
                <td width="136pt" align="right" style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt; background-color: #dddddd;"><b>Amount Paid (CAD)</b></td>
            </tr>
<#if check.apply?has_content>
    <#list check.apply as bill>
            <tr>
                <td style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">${bill.applydate!""}</td>
                <td style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">${bill.refnum!""}</td>
                <td align="right" style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">${bill.amount!""}</td>
            </tr>
    </#list>
    <#if check.apply?size lt 8>
        <#list 1..(8 - check.apply?size) as blankRow>
            <tr><td style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">&#160;</td><td style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">&#160;</td><td style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">&#160;</td></tr>
        </#list>
    </#if>
<#else>
            <tr><td style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">${check.trandate}</td><td style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">${check.memo!""}</td><td align="right" style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;"><#if (check.usertotal!"")?has_content>
${check.usertotal}
<#else>
${check.total}
</#if></td></tr>
    <#list 1..7 as blankRow>
            <tr><td style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">&#160;</td><td style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">&#160;</td><td style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">&#160;</td></tr>
    </#list>
</#if>
            <tr><td colspan="2" align="right" style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt; background-color: #eeeeee;"><b>Check Total (CAD)</b></td><td align="right" style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt; background-color: #eeeeee;"><b><#if (check.usertotal!"")?has_content>
${check.usertotal}
<#else>
${check.total}
</#if></b></td></tr>
        </table>
        <#-- Voucher 2: independent remittance markup. -->
        <table style="position: absolute; left: 18pt; top: 324pt; width: 576pt; font-size: 8pt;">
            <tr><td width="365pt"><b>REMITTANCE - CAD</b><br />Payee: ${check.entity}</td><td align="right">Date: ${check.trandate}<br />Check: ${check.checknumber}</td></tr>
        </table>
        <table class="remittance" cellpadding="0" cellspacing="0" style="position: absolute; left: 18pt; top: 356pt; width: 576pt; border-collapse: collapse; border: 0.75pt solid #333333; background-color: #ffffff; font-size: 8pt; table-layout: fixed;">
            <tr>
                <td width="100pt" style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt; background-color: #dddddd;"><b>Invoice Date</b></td>
                <td width="340pt" style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt; background-color: #dddddd;"><b>Invoice / Reference</b></td>
                <td width="136pt" align="right" style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt; background-color: #dddddd;"><b>Amount Paid (CAD)</b></td>
            </tr>
<#if check.apply?has_content>
    <#list check.apply as bill>
            <tr>
                <td style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">${bill.applydate!""}</td>
                <td style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">${bill.refnum!""}</td>
                <td align="right" style="border: 0.5pt solid #555555; padding: 2pt 4pt; height: 13pt;">${bill.amount!""}</td>
            </tr>
